# DeepSeek API Key (Lấy từ platform.deepseek.com)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mật khẩu Token để bảo vệ server (điền vào Kindle KOAssistant)
AUTH_TOKEN=kindle-secret-token-123456

# (Tùy chọn) Tavily Search API Key để tăng tốc tìm kiếm
TAVILY_API_KEY=

# Bật/Tắt tìm kiếm Web tự động
ENABLE_WEB_SEARCH=true
SEARCH_MAX_RESULTS=5
