# DeepSeek API Key (Lấy từ platform.deepseek.com)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_MODEL=deepseek-flash

# Mật khẩu Token để bảo vệ server (điền vào Kindle KOAssistant)
# Token máy riêng cho KOAssistant (tạo ngẫu nhiên >= 32 ký tự; không dùng mật khẩu admin)
AUTH_TOKEN=replace-with-random-machine-token-at-least-32-chars

# Mật khẩu đăng nhập trang /admin (>= 12 ký tự)
ADMIN_PASSWORD=replace-with-your-admin-password

# Khóa ký cookie phiên, phải là chuỗi ngẫu nhiên độc lập >= 32 ký tự
SESSION_SECRET=replace-with-another-random-secret-at-least-32-chars

# (Tùy chọn) Tavily Search API Key để tăng tốc tìm kiếm
TAVILY_API_KEY=

# Bật/Tắt tìm kiếm Web tự động
ENABLE_WEB_SEARCH=true
SEARCH_MAX_RESULTS=5
DATA_DIR=/data
ENABLE_SCHEDULER=true
ENABLE_DOCS=false

# Để trống nếu không có frontend web khác domain. Không dùng dấu *.
ALLOWED_ORIGINS=
